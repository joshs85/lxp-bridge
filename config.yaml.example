loglevel: info

inverters:
- enabled: true
  host: localhost
  port: 8000
  serial: 5555555555
  datalog: 2222222222
  heartbeats: false
  publish_holdings_on_connect: true
  read_timeout: 300                  # ⚠️ OPTIMIZED: 5 minutes - inverter sends data only when values change
- enabled: false
  host: 192.168.0.163
  port: 8000
  serial: 9999999999
  datalog: 3333333333
  heartbeats: false
  publish_holdings_on_connect: true

mqtt:
  enabled: true
  host: localhost
  port: 1883
  username:
  password:
  namespace: lxp
  publish_individual_input: true
  homeassistant_enabled: true
  homeassistant_prefix: homeassistant
  
  # Reliability settings - IMPROVED to prevent restarts
  max_retries: 10                   # Increased from 3 for better resilience
  circuit_breaker_threshold: 20     # Increased from 5 to be more tolerant
  reconnect_delay_secs: 5           # Increased from 1 to reduce rapid reconnection attempts
  max_reconnect_delay_secs: 600     # Increased to 10 minutes for better stability

scheduler:
  enabled: true
  timesync_cron: "0 0 * * *"
